<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.enumtech.healthline">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:label="HealthLine"
        android:supportsRtl="true"
        android:theme="@style/Theme.HealthLine">
        <activity
            android:name=".AmbulanceManageRequestActivity"
            android:exported="false" />
        <activity
            android:name=".BookAmbulanceActivity"
            android:exported="false" />
        <activity
            android:name=".AmbulanceManageProfileActivity"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="false" />
        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".BloodDonorList" />
        <activity android:name=".BloodDonorManageProfile" />
        <activity android:name=".BookDoctorAppointment" />
        <activity android:name=".BookingConfirmationActivity" />
        <activity android:name=".DoctorScheduleManagement" />
        <activity android:name=".MyAppointmentActivity" />
        <activity android:name=".RegisterActivity" />
        <activity android:name=".TrackSerialActivity" />
        <activity android:name=".UpdateSerialActivity" />
        <activity android:name=".DoctorManageProfile" />
    </application>

</manifest>