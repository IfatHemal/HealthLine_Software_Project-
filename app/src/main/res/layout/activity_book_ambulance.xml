<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".BookAmbulanceActivity"
    android:orientation="vertical"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="#E8EEF7"
        >



        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                >

                <EditText
                    android:id="@+id/searchBar"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="🔍   Search by location"
                    android:background="@drawable/bg_input_field"
                    android:paddingLeft="12dp"
                    android:textColor="#000000"
                    android:textColorHint="#5B5B5B"/>




                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="10dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_card"
                    android:padding="10dp"
                    >


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Pickup Location"
                        android:textSize="16sp"
                        android:layout_marginBottom="5dp"
                        android:textColor="#0159C7"
                        android:textStyle="bold"
                        />
                    <EditText
                        android:id="@+id/etpickuplocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Enter pickup location"
                        android:padding="4dp"
                        android:textColorHint="#545454"
                        android:textColor="#000000"
                        android:background="@null"
                        />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:background="#000000"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Destination Location"
                        android:textSize="16sp"
                        android:textColor="#0159C7"
                        android:layout_marginBottom="5dp"
                        android:textStyle="bold"
                        />
                    <EditText
                        android:id="@+id/etdestinationlocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Enter destination location"
                        android:padding="4dp"
                        android:textColor="#000000"
                        android:textColorHint="#545454"
                        android:background="@null"
                        />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Contact Number"
                        android:textSize="16sp"
                        android:textColor="#0159C7"
                        android:layout_marginBottom="5dp"
                        android:textStyle="bold"
                        android:layout_marginTop="5dp"
                        />
                    <EditText
                        android:id="@+id/etcontactnumber"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Enter your phone number"
                        android:padding="4dp"
                        android:textColor="#000000"
                        android:textColorHint="#545454"
                        android:background="@null"
                        />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:background="#000000"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        />

                    <Button
                        android:id="@+id/dateBtn"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:text="Select Date"
                        android:backgroundTint="#045CF3"
                        android:textColor="#ffffff"
                        />

                    <Button
                        android:id="@+id/timeBtn"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:text="Select Time"
                        android:backgroundTint="#045CF3"
                        android:textColor="#ffffff"
                        />




                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    >

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Available Ambulances"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#000000"
                        android:layout_margin="10dp"
                        />

                    <ListView
                        android:id="@+id/ambulanceList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:divider="@android:color/transparent"
                        android:dividerHeight="8dp"
                        android:nestedScrollingEnabled="true"

                        />



                </LinearLayout>






            </LinearLayout>

        </ScrollView>


    </LinearLayout>



</LinearLayout>