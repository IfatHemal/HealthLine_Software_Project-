<?xml version="1.0" encoding="utf-8"?>
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".MyAmbulanceRequestActivity"
        android:orientation="vertical"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#E8EEF7"
            android:padding="20dp"
            >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="All Active Request"
                android:textColor="#0356FB"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"

                />
            <TextView
                android:id="@+id/totalrequest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Total Request"
                android:textColor="#BA021D"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"

                />

            <ListView
                android:id="@+id/bookingRequestListView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@android:color/transparent"
                android:dividerHeight="8dp"
                android:nestedScrollingEnabled="true"

                />
        </LinearLayout>

    </LinearLayout>
