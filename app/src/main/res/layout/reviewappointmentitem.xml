<?xml version="1.0" encoding="utf-8"?>


<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="15dp"
    android:background="@drawable/bg_icon_box_blue"
    android:elevation="2dp"
    android:layout_margin="10dp"
    >


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="10dp"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3"
            >
            <TextView
                android:id="@+id/tvname"
                android:text="Dr. Arpon Chowdhury"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#000000"
                android:layout_weight="2"/>





        </LinearLayout>




        <TextView
            android:id="@+id/tvSpeciality"
            android:text="Cardiologist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#000000"
            />

        <TextView
            android:id="@+id/tvHospital"
            android:text="Lab Aid Diagnostic Center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#000000"
            />

        <TextView
            android:id="@+id/tvSchedule"
            android:text="Appointment DateTime: 02/10/2026"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#000000"
            />

        <TextView
            android:id="@+id/tvfees"
            android:text="Fee: 500৳"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#000000"
            />


        <Button
            android:id="@+id/btnreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Give Review"
            android:layout_gravity="right"
            android:layout_marginRight="7dp"
            android:layout_weight="1"
            android:backgroundTint="#DE0109"
            android:textColor="#ffffff"
            />






    </LinearLayout>


</LinearLayout>