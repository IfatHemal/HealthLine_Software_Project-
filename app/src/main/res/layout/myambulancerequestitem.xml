<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="15dp"
    android:background="@drawable/bg_card"
    >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="🚑"
            android:textSize="50dp"
            />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            >


            <TextView
                android:id="@+id/tvambulancename"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="City Emergency Ambulance"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="10dp"

                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_gravity="clip_vertical"
                />
            <TextView
                android:id="@+id/tvambulancelicence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Licence No. DC-22-5432"
                android:layout_marginLeft="10dp"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#015495"
                android:layout_gravity="clip_vertical"
                />

            <TextView
                android:id="@+id/tvambulancetype"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ICU Equipped"
                android:layout_marginLeft="10dp"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#018BF8"
                android:layout_gravity="clip_vertical"
                />



        </LinearLayout>




    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2"
        android:layout_margin="5dp"
        >



        <TextView
            android:id="@+id/tvdrivername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👤   Shah Arpon"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="5dp"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_weight="1"
            android:background="@drawable/bg_icon_box_blue"

            />

        <TextView
            android:id="@+id/tvstatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pending"
            android:layout_marginRight="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="5dp"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:gravity="center"
            android:layout_weight="1"
            android:background="@drawable/bg_icon_box_green"

            />


    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="7dp"
        >
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="35dp"
            android:src="@drawable/location_icon"
            />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            >


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pickup"
                android:textColor="#000000"
                android:textSize="14sp"
                />
            <TextView
                android:id="@+id/tvpickup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mirpur-10, Dhaka"
                android:textStyle="bold"
                android:textColor="#000000"
                android:textSize="15sp"
                />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="7dp"
        >
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="35dp"
            android:src="@drawable/destination_icon"
            />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            >


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Destination"
                android:textColor="#000000"
                android:textSize="14sp"
                />
            <TextView
                android:id="@+id/tvdestination"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Apollo Hospital Dhaka"
                android:textStyle="bold"
                android:textColor="#000000"
                android:textSize="15sp"
                />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="7dp"
        >
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="35dp"
            android:src="@drawable/calender_icon"
            />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            >


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Date"
                android:textColor="#000000"
                android:textSize="14sp"
                />
            <TextView
                android:id="@+id/tvdate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="20 Apr, 2026"
                android:textStyle="bold"
                android:textColor="#000000"
                android:textSize="15sp"
                />
        </LinearLayout>

    </LinearLayout>





    <LinearLayout
        android:id="@+id/layoutcontact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="7dp"
        android:visibility="gone"
        >
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="35dp"
            android:src="@drawable/call_icon"
            />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            >


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Contact"
                android:textColor="#000000"
                android:textSize="14sp"
                />
            <TextView
                android:id="@+id/tvcontact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="017xxxxxxx45"
                android:textStyle="bold"
                android:textColor="#000000"
                android:textSize="15sp"
                />
        </LinearLayout>


    </LinearLayout>


    <Button
        android:id="@+id/btncancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cancel"
        android:layout_marginTop="7dp"
        android:textColor="#ffffff"
        android:backgroundTint="#3F51B5"
        />

    <Button
        android:id="@+id/btncontact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📞  Call"
        android:layout_marginTop="7dp"
        android:textColor="#ffffff"
        android:backgroundTint="#009688"
        android:visibility="gone"
        />

</LinearLayout>